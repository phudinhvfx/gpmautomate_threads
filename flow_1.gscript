        "id": "1478332c-e440-4ecc-99a1-f5817f720216",
        "display_text": "Normal block",
        "raw_input": null,
        "comment": "GHI CHÚ FLOW 1\n- Thao tác chính: random cuộn feed, chọn bài gần màn hình, đọc nội dung và Thích theo điều kiện.\n- Sửa số random Thích: trong Block #3 `random like decision` → node #1 `random like number` (MIN/MAX). Điều kiện Thích ở node #2 cùng Block #3.\n- Cách đếm: dùng số thứ tự node/block hiển thị trong GPM Automate, tính cả block ghi chú này."
      },
      {
        "$type": "GPMAutomateEditor.Models.NormalBlockNode, GPMAutomateEditor.Models",
        "nodes": [
          {
            "$type": "GPMAutomateEditor.Models.ActionNode, GPMAutomateEditor.Models",
            "type": 57,
            "element_xpath": null,
            "output_variable_name": null,
            "delay": "0,0",
            "continue_on_error": false,
            "id": "4678e079-9851-412a-b1d2-154b525e9f04",
            "display_text": null,
            "raw_input": "[]",
            "comment": "random scroll"
          },
          {
            "$type": "GPMAutomateEditor.Models.ActionNode, GPMAutomateEditor.Models",
            "type": 53,
            "element_xpath": null,
            "output_variable_name": null,
            "delay": "1000,4000",
            "continue_on_error": false,
            "id": "594cb23c-000e-4d54-bbcb-3dac09d229e6",
            "display_text": null,
            "raw_input": "[{\"Key\":\"SCROLL_NUM\",\"Value\":\"2\"}]",
            "comment": "extra mouse scroll"
          },
          {
            "$type": "GPMAutomateEditor.Models.ActionNode, GPMAutomateEditor.Models",
            "type": 7,
            "element_xpath": null,
            "output_variable_name": null,
            "delay": "1000,3000",
            "continue_on_error": false,
            "id": "fa280c76-168e-4d22-9897-91cce17719be",
            "display_text": null,
            "raw_input": "[{\"Key\":\"MIN\",\"Value\":\"3000\"},{\"Key\":\"MAX\",\"Value\":\"6000\"}]",
            "comment": "wait feed..."
          },
          {
            "$type": "GPMAutomateEditor.Models.ActionNode, GPMAutomateEditor.Models",
            "type": 68,
            "element_xpath": null,
            "output_variable_name": "postRef",
            "delay": "4000,6000",
            "continue_on_error": false,
            "id": "832512b3-0c26-4e29-9bc6-318b2a2329fa",
            "display_text": null,
            "raw_input": "[{\"Key\":\"FILE_OR_CODE\",\"Value\":\"function A(){\\nvar old=document.querySelectorAll('[data-gpm-threads-post-ref],[data-gpm-threads-like-ref]');\\nold.forEach(function(x){x.removeAttribute('data-gpm-threads-post-ref');x.removeAttribute('data-gpm-threads-like-ref');});\\nfunction titleOf(x){var icon=x.querySelector('svg[title]');return icon?(icon.getAttribute('title')||''):'';}\\nfunction isLike(x){return /^(Thích|Like|Bỏ thích|Unlike|Remove Like)/i.test(titleOf(x));}\\nfunction visible(x){var r=x.getBoundingClientRect();return r.width>0&&r.height>0;}\\nfunction postOf(x){for(var n=x;n&&n!==document.body;n=n.parentElement){var links=n.querySelectorAll('a[href*=\\\"/post/\\\"]');if(links.length===1&&n.querySelector('[role=\\\"button\\\"] svg[title=\\\"Thích\\\"],[role=\\\"button\\\"] svg[title=\\\"Like\\\"],[role=\\\"button\\\"] svg[title=\\\"Bỏ thích\\\"],[role=\\\"button\\\"] svg[title=\\\"Unlike\\\"]')){return n;}}return null;}\\nvar likes=Array.prototype.filter.call(document.querySelectorAll('[role=\\\"button\\\"]'),function(x){return isLike(x)&&visible(x);});\\nif(!likes.length){return '';}\\nlikes.sort(function(a,b){var ra=a.getBoundingClientRect(),rb=b.getBoundingClientRect();return Math.abs((ra.top+ra.bottom)/2-window.innerHeight/2)-Math.abs((rb.top+rb.bottom)/2-window.innerHeight/2);});\\nvar like=likes[0],post=postOf(like);if(!post){return '';}\\nlike.scrollIntoView({block:'center'});\\nvar ref='gpm-threads-'+Date.now()+'-'+Math.floor(Math.random()*1000000);\\npost.setAttribute('data-gpm-threads-post-ref',ref);like.setAttribute('data-gpm-threads-like-ref',ref);return ref;\\n} return A();\"}]",
            "comment": "create Threads post ref"
          },
          {
            "$type": "GPMAutomateEditor.Models.ActionNode, GPMAutomateEditor.Models",
            "type": 68,
            "element_xpath": null,
            "output_variable_name": "postAuthor",
            "delay": "400,1600",
            "continue_on_error": false,
            "id": "9047930e-39b9-43e5-a8b7-27e6082938b5",
            "display_text": null,
            "raw_input": "[{\"Key\":\"FILE_OR_CODE\",\"Value\":\"function A(){var p=document.querySelector('[data-gpm-threads-post-ref]');if(!p){return 'NOT_FOUND';}var links=p.querySelectorAll('a[href^=\\\"/@\\\"]:not([href*=\\\"/post/\\\"])');for(var i=0;i<links.length;i++){var name=(links[i].innerText||'').trim();if(name){return name;}}return 'NOT_FOUND';} return A();\"}]",
            "comment": "get post author"
          },
          {
            "$type": "GPMAutomateEditor.Models.ActionNode, GPMAutomateEditor.Models",
            "type": 68,
            "element_xpath": null,
            "output_variable_name": "postContent",
            "delay": "500,3000",
            "continue_on_error": false,
            "id": "95dbfdfe-b912-4e83-8149-b9a4b0385486",
            "display_text": null,
            "raw_input": "[{\"Key\":\"FILE_OR_CODE\",\"Value\":\"function A(){var p=document.querySelector('[data-gpm-threads-post-ref]');return p?((p.innerText||'').trim()):'';} return A();\"}]",
            "comment": "get post content"
          },
          {
            "$type": "GPMAutomateEditor.Models.ActionNode, GPMAutomateEditor.Models",
            "type": 68,
            "element_xpath": null,
            "output_variable_name": "postPermalink",
            "delay": "600,2800",
            "continue_on_error": false,
            "id": "1ea1e971-57a4-40d3-b7cd-bf97e2b1486c",
            "display_text": null,
            "raw_input": "[{\"Key\":\"FILE_OR_CODE\",\"Value\":\"function A(){var p=document.querySelector('[data-gpm-threads-post-ref]');var a=p?p.querySelector('a[href*=\\\"/post/\\\"]'):null;return a?(a.getAttribute('href')||''):'NOT_FOUND';} return A();\"}]",
            "comment": "get post permalink"
          },
          {
            "$type": "GPMAutomateEditor.Models.ActionNode, GPMAutomateEditor.Models",
            "type": 68,
            "element_xpath": null,
            "output_variable_name": "likeButton",
            "delay": "600,2800",
            "continue_on_error": false,
            "id": "aede9bbf-56c6-49d2-a84f-da8d06fa7e50",
            "display_text": null,
            "raw_input": "[{\"Key\":\"FILE_OR_CODE\",\"Value\":\"function A(){var n=document.querySelector('[data-gpm-threads-like-ref=\\\"$postRef\\\"]');if(!n){return 'NOT_FOUND';}var icon=n.querySelector('svg[title]');var title=icon?(icon.getAttribute('title')||''):'';if(/^(Bỏ thích|Unlike|Remove Like)/i.test(title)){return 'ALREADY_LIKED';}if(/^(Thích|Like)/i.test(title)){return 'READY_TO_LIKE';}return 'UNKNOWN_LIKE_STATE: '+title;} return A();\"}]",
            "comment": "get like state"
          },
          {
            "$type": "GPMAutomateEditor.Models.ActionNode, GPMAutomateEditor.Models",
            "type": 68,
            "element_xpath": null,
            "output_variable_name": "postSummary",
            "delay": "900,3000",
            "continue_on_error": false,
            "id": "bb428a64-a8a3-4f2a-a7c8-a1debf5015b6",
            "display_text": null,
            "raw_input": "[{\"Key\":\"FILE_OR_CODE\",\"Value\":\"function A(){var p=document.querySelector('[data-gpm-threads-post-ref]');if(!p){return 'POST_NOT_FOUND';}var a='UNKNOWN',links=p.querySelectorAll('a[href^=\\\"/@\\\"]:not([href*=\\\"/post/\\\"])');for(var i=0;i<links.length;i++){var name=(links[i].innerText||'').trim();if(name){a=name;break;}}var text=(p.innerText||'').trim().replace(/\\\\s+/g,' ');return 'AUTHOR: '+a+' | CONTENT(50): '+text.slice(0,50);} return A();\"}]",
            "comment": "log post summary"
          }
        ],
        "expanded": true,
        "continue_on_error": false,
