                    ],
                    "expanded": true,
                    "continue_on_error": false,
                    "id": "6db4b7a0-7353-4ec5-b035-9af9a82bc158",
                    "display_text": "If",
                    "raw_input": "[{\"Key\":\"CONDITION\",\"Value\":\"$likeStatusBefore = \\\"READY_TO_LIKE\\\"\"}]",
                    "comment": "click only if ready"
                  },
                  {
                    "$type": "GPMAutomateEditor.Models.ActionNode, GPMAutomateEditor.Models",
                    "type": 7,
                    "element_xpath": null,
                    "output_variable_name": null,
                    "delay": "300,3000",
                    "continue_on_error": false,
                    "id": "6d05af0a-b090-4b2b-83ec-2d0ce101af93",
                    "display_text": null,
                    "raw_input": "[{\"Key\":\"MIN\",\"Value\":\"800\"},{\"Key\":\"MAX\",\"Value\":\"1200\"}]",
                    "comment": "wait like..."
                  },
                  {
                    "$type": "GPMAutomateEditor.Models.ActionNode, GPMAutomateEditor.Models",
                    "type": 68,
                    "element_xpath": null,
                    "output_variable_name": "likeStatus",
                    "delay": "400,4000",
                    "continue_on_error": false,
                    "id": "90a60bca-5667-4d9f-a595-5dfe9db645d8",
                    "display_text": null,
                    "raw_input": "[{\"Key\":\"FILE_OR_CODE\",\"Value\":\"function A(){var before=\\\"$likeStatusBefore\\\";var n=document.querySelector('[data-gpm-threads-like-ref=\\\"$postRef\\\"]');if(!n){return 'NOT_FOUND';}if(before!=='READY_TO_LIKE'){return before;}var icon=n.querySelector('svg[title]');var title=icon?(icon.getAttribute('title')||''):'';return /^(Bỏ thích|Unlike|Remove Like)/i.test(title)?'LIKE_SUCCESS':'LIKE_CLICKED_BUT_UNCONFIRMED: '+title;} return A();\"}]",
                    "comment": "log like status"
                  }
