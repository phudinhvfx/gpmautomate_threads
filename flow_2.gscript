            "delay": "430,3100",
            "continue_on_error": false,
            "id": "ced721f2-4c3d-4918-865c-28c4de979c23",
            "display_text": null,
            "raw_input": "[{\"Key\":\"FILE_OR_CODE\",\"Value\":\"function A(){\\nfunction visible(e){var r=e.getBoundingClientRect(),s=getComputedStyle(e);return e.isConnected&&r.width>0&&r.height>0&&s.display!='none'&&s.visibility!='hidden';}\\nfunction titleOf(e){var icon=e.querySelector('svg[title]');return icon?(icon.getAttribute('title')||''):'';}\\nfunction isReply(e){return /^(Trả lời|Reply)/i.test(titleOf(e));}\\nfunction postOf(e){for(var n=e;n&&n!==document.body;n=n.parentElement){var links=n.querySelectorAll('a[href*=\\\"/post/\\\"]');if(links.length===1){return n;}}return null;}\\ndocument.querySelectorAll('[data-gpm-threads-post-ref],[data-gpm-threads-reply-ref],[data-gpm-threads-post-context]').forEach(function(e){e.removeAttribute('data-gpm-threads-post-ref');e.removeAttribute('data-gpm-threads-reply-ref');e.removeAttribute('data-gpm-threads-post-context');});\\nvar replies=Array.prototype.filter.call(document.querySelectorAll('[role=\\\"button\\\"]'),function(e){return visible(e)&&isReply(e);});if(!replies.length){return '';}\\nreplies.sort(function(a,b){var ra=a.getBoundingClientRect(),rb=b.getBoundingClientRect();return Math.abs((ra.top+ra.bottom)/2-innerHeight/2)-Math.abs((rb.top+rb.bottom)/2-innerHeight/2);});\\nvar reply=replies[0],post=postOf(reply);if(!post){return '';}reply.scrollIntoView({block:'center'});\\nvar ref='gpm-threads-'+Date.now()+'-'+Math.floor(Math.random()*1000000);post.setAttribute('data-gpm-threads-post-ref',ref);reply.setAttribute('data-gpm-threads-reply-ref',ref);return ref;\\n} return A();\"}]",
            "comment": "create Threads post ref"
          },
          {
            "$type": "GPMAutomateEditor.Models.ActionNode, GPMAutomateEditor.Models",
            "type": 68,
            "element_xpath": null,
            "output_variable_name": "postContextStatus",
            "delay": "0,0",
            "continue_on_error": false,
            "id": "38ef465a-485c-4ab0-bae9-b4d1343d7b94",
            "display_text": null,
            "raw_input": "[{\"Key\":\"FILE_OR_CODE\",\"Value\":\"function A(){document.querySelectorAll('[data-gpm-threads-post-context]').forEach(function(e){e.removeAttribute('data-gpm-threads-post-context');});var p=document.querySelector('[data-gpm-threads-post-ref=\\\"$postRef\\\"]');if(!p||!p.isConnected){return 'CONTEXT_LOST';}p.setAttribute('data-gpm-threads-post-context','1');return 'POST_CONTEXT_READY';} return A();\"}]",
            "comment": "mark Threads post context"
          },
          {
            "$type": "GPMAutomateEditor.Models.ActionNode, GPMAutomateEditor.Models",
            "type": 68,
            "element_xpath": null,
