            "continue_on_error": false,
            "id": "47fc957e-fa5d-4f40-a9ea-c021fdc70e0d",
            "display_text": null,
            "raw_input": "[{\"Key\":\"FILE_OR_CODE\",\"Value\":\"function A(){var p=document.querySelector('[data-gpm-threads-post-ref]');if(!p){return 'POST_NOT_FOUND';}var author='UNKNOWN',links=p.querySelectorAll('a[href^=\\\"/@\\\"]:not([href*=\\\"/post/\\\"])');for(var i=0;i<links.length;i++){var name=(links[i].innerText||'').trim();if(name){author=name;break;}}var text=(p.innerText||'').replace(/\\\\s+/g,' ').trim();return 'AUTHOR: '+author+' | CONTENT(50): '+text.slice(0,50);} return A();\"}]",
            "comment": "log post summary"
          }
