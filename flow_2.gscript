            "id": "cb5b4fcb-4e0b-4a53-bdf3-20b89d82d142",
            "display_text": null,
            "raw_input": "[{\"Key\":\"FILE_OR_CODE\",\"Value\":\"function A(){var n=document.querySelector('[data-gpm-threads-reply-ref]');var icon=n?n.querySelector('svg[title]'):null;return icon?(icon.getAttribute('title')||''):'NOT_FOUND';} return A();\"}]",
            "comment": "get Threads reply button"
          },
          {
            "$type": "GPMAutomateEditor.Models.ActionNode, GPMAutomateEditor.Models",
            "type": 68,
