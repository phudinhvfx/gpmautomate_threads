            "id": "a5cfa692-1e15-465c-a197-a246f77a7b62",
            "display_text": null,
            "raw_input": "[{\"Key\":\"FILE_OR_CODE\",\"Value\":\"function A(){var p=document.querySelector('[data-gpm-threads-post-ref]');if(!p){return 'NOT_FOUND';}var links=p.querySelectorAll('a[href^=\\\"/@\\\"]:not([href*=\\\"/post/\\\"])');for(var i=0;i<links.length;i++){var name=(links[i].innerText||'').trim();if(name){return name;}}return 'NOT_FOUND';} return A();\"}]",
            "comment": "get post author"
          },
          {
            "$type": "GPMAutomateEditor.Models.ActionNode, GPMAutomateEditor.Models",
