            "id": "2ea6d86f-2dce-46e7-a175-d4ac048e7f86",
            "display_text": null,
            "raw_input": "[{\"Key\":\"FILE_OR_CODE\",\"Value\":\"function mark(){\\nfunction visible(e){var r=e.getBoundingClientRect(),s=getComputedStyle(e);return e.isConnected&&r.width>0&&r.height>0&&s.display!='none'&&s.visibility!='hidden';}\\nfunction titleOf(e){var svg=e.querySelector('svg[title]');return svg?(svg.getAttribute('title')||''):'';}\\nfunction isReply(e){return /^(Trả lời|Reply)/i.test(titleOf(e));}\\nfunction postOf(e){for(var n=e;n&&n!==document.body;n=n.parentElement){var links=n.querySelectorAll('a[href*=\\\"/post/\\\"]');if(links.length===1){return n;}}return null;}\\nvar old=document.querySelectorAll('[data-gpm-threads-post-ref],[data-gpm-threads-reply-ref],[data-gpm-threads-scroll-ref],[data-gpm-threads-back-ref]');\\nold.forEach(function(e){e.removeAttribute('data-gpm-threads-post-ref');e.removeAttribute('data-gpm-threads-reply-ref');e.removeAttribute('data-gpm-threads-scroll-ref');e.removeAttribute('data-gpm-threads-back-ref');});\\nvar replies=Array.prototype.filter.call(document.querySelectorAll('[role=\\\"button\\\"]'),function(e){return visible(e)&&isReply(e);});\\nif(!replies.length){return 'TARGET_NOT_FOUND';}\\nreplies.sort(function(a,b){var ra=a.getBoundingClientRect(),rb=b.getBoundingClientRect();return Math.abs((ra.top+ra.bottom)/2-innerHeight/2)-Math.abs((rb.top+rb.bottom)/2-innerHeight/2);});\\nvar reply=replies[0],post=postOf(reply);if(!post){return 'TARGET_NOT_FOUND';}\\nreply.scrollIntoView({block:'center'});\\nvar ref='gpm-threads-'+Date.now()+'-'+Math.random().toString(36).slice(2);\\npost.setAttribute('data-gpm-threads-post-ref',ref);reply.setAttribute('data-gpm-threads-reply-ref',ref);\\nwindow.__gpmThreadsFlow3={ref:ref,initialUrl:location.href,postRoot:post,button:reply};\\nreturn 'TARGET_READY';\\n} return mark();\"}]",
            "comment": "mark Threads reply"
          },
